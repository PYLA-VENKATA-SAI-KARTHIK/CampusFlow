# =============================================================================
# CampusFlow Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your local values.
# NEVER commit .env to source control.
# NEVER put real credentials in this file.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=CampusFlow
DEBUG=true
LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://campusflow:campusflow_dev@localhost:5432/campusflow_dev
DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# JWT / JWKS (RS256)
# ---------------------------------------------------------------------------
# Key ID — label for this key pair. Change when rotating keys.
JWT_KEY_ID=campusflow-dev-key-v1

# RSA private key (PEM format, base64-encoded for env var safety)
# For local development ONLY — generate with:
#   openssl genrsa -out dev_private.pem 2048
#   openssl rsa -in dev_private.pem -pubout -out dev_public.pem
#   base64 -w 0 dev_private.pem   (Linux) or base64 dev_private.pem (macOS)
# NEVER use a development key in production.
JWT_PRIVATE_KEY_BASE64=<base64-encoded-RSA-2048-private-key-PEM>
JWT_PUBLIC_KEY_BASE64=<base64-encoded-RSA-2048-public-key-PEM>

# Token lifetimes (seconds)
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900       # 15 minutes
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800   # 7 days

# Token issuer — set to the public-facing API URL when deploying
JWT_ISSUER=http://localhost:8000

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# EMAIL_PROVIDER controls which adapter is used:
#   mock      — logs activation links to console (local dev, no credentials needed)
#   sendgrid  — real SendGrid delivery (requires SENDGRID_API_KEY)
EMAIL_PROVIDER=mock

# Required when EMAIL_PROVIDER=sendgrid
# Store in Secret Manager in production — NEVER commit the real key
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@campusflow.internal
SENDGRID_FROM_NAME=CampusFlow

# ---------------------------------------------------------------------------
# Frontend URL (used in activation email links)
# ---------------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_ACTIVATE=5/15minutes
RATE_LIMIT_RESEND_ACTIVATION_MAX=5
RATE_LIMIT_RESEND_ACTIVATION_MIN_GAP_MINUTES=10

# ---------------------------------------------------------------------------
# Admin seed (optional — creates a bootstrap admin on first startup)
# Leave blank in production; use secure onboarding instead.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
